# systemd EnvironmentFile; copy to .env on Ubuntu, fill values, chmod 600
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
WAN_IMAGE_MODEL=wan2.2-t2i-flash
WAN_VIDEO_MODEL=wan2.2-i2v-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_TTS_MODEL=qwen3-tts-flash
PUBLIC_ORIGIN=https://wyf.suiyizou.xyz
ALLOWED_HOSTS=wyf.suiyizou.xyz
ALLOW_REGISTRATION=0
YOUTUBE_CONFIG_DIR=/home/ubuntu/ai-marketing-agent/work/secrets/youtube
YOUTUBE_REDIRECT_URI=https://wyf.suiyizou.xyz/api/auth/youtube/callback
# Optional proxy for Google APIs only; omit when direct access works.
YOUTUBE_HTTPS_PROXY=
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_SECONDS=3600
PLAYWRIGHT_BROWSERS_PATH=/home/ubuntu/.cache/ms-playwright
NODE_OPTIONS=--max-old-space-size=512
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
